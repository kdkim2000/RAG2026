# ==========================================
# 1. 파이썬 가상환경 (Virtual Environments)
# ==========================================
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ==========================================
# 2. 파이썬 컴파일 및 바이트코드 파일
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# 3. 주피터 노트북 (Jupyter Notebook) 특화
# ==========================================
# 노트북 자동 저장 / 체크포인트 폴더
.ipynb_checkpoints

# 노트북 내 실행 결과나 프로필 설정
.jupyter/

# ==========================================
# 4. 환경 변수 및 보안 (API Key, 비밀번호 등)
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# 5. OS 및 IDE 설정 파일
# ==========================================
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# PyCharm / IntelliJ
.idea/

# ==========================================
# 6. 패키징 및 빌드 결과물
# ==========================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg

# ==========================================
# 7. 데이터 및 로그 (용량이 크거나 변경이 잦은 파일)
# ==========================================
*.log
*.sqlite3
*.db
data/
datasets/
chroma*/
embedding/
.embedding/
outputs/
*.zip